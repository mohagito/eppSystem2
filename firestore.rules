rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security validators
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Profiles Collection
    match /profiles/{profileId} {
      allow read: if true;
      allow create, update: if isValidId(profileId) 
        && request.resource.data.id == profileId
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.role is string && (request.resource.data.role == 'manager' || request.resource.data.role == 'worker')
        && request.resource.data.username is string && request.resource.data.username.size() <= 100
        && request.resource.data.password is string && request.resource.data.password.size() <= 100;
      allow delete: if isValidId(profileId);
    }

    // Stock Entries Collection
    match /stock_entries/{entryId} {
      allow read: if true;
      allow create, update: if isValidId(entryId)
        && request.resource.data.id == entryId
        && request.resource.data.modelId is string && request.resource.data.modelId.size() <= 50
        && request.resource.data.workerName is string && request.resource.data.workerName.size() <= 100
        && request.resource.data.date is string && request.resource.data.date.size() <= 50
        && (request.resource.data.quantity is int || request.resource.data.quantity is float)
        && request.resource.data.createdBy is string
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);
      allow delete: if isValidId(entryId);
    }

    // Deliveries Collection
    match /deliveries/{deliveryId} {
      allow read: if true;
      allow create, update: if isValidId(deliveryId)
        && request.resource.data.id == deliveryId
        && request.resource.data.modelId is string && request.resource.data.modelId.size() <= 50
        && request.resource.data.model is string && request.resource.data.model.size() <= 50
        && request.resource.data.workerName is string && request.resource.data.workerName.size() <= 100
        && request.resource.data.loadedBy is string && request.resource.data.loadedBy.size() <= 100
        && request.resource.data.invoiceNumber is string && request.resource.data.invoiceNumber.size() <= 100
        && isValidDate(request.resource.data.date)
        && request.resource.data.deliveryDate is string && request.resource.data.deliveryDate.size() <= 50
        && request.resource.data.deliveryTime is string && request.resource.data.deliveryTime.size() <= 50
        && (request.resource.data.quantity is int || request.resource.data.quantity is float) && request.resource.data.quantity >= 0
        && request.resource.data.createdBy is string
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);
      allow delete: if isValidId(deliveryId);
    }

    // Production Plans Collection
    match /production_plans/{planId} {
      allow read: if true;
      allow create, update: if isValidId(planId)
        && request.resource.data.id == planId
        && request.resource.data.planDate is string && request.resource.data.planDate.size() <= 50
        && request.resource.data.machine is string && request.resource.data.machine.size() <= 50
        && request.resource.data.shift is string && request.resource.data.shift.size() <= 50
        && request.resource.data.model is string && request.resource.data.model.size() <= 50
        && (request.resource.data.quantityPlanned is int || request.resource.data.quantityPlanned is float) && request.resource.data.quantityPlanned >= 0
        && request.resource.data.assignedWorker is string && request.resource.data.assignedWorker.size() <= 100
        && request.resource.data.status is string && (request.resource.data.status == 'Pending' || request.resource.data.status == 'Completed' || request.resource.data.status == 'Delayed')
        && request.resource.data.createdBy is string
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);
      allow delete: if isValidId(planId);
    }

    // Rolls Traceability Collection (Hardened protection for factory stock)
    match /rolls/{rollId} {
      allow read: if true;
      allow create, update: if isValidId(rollId)
        && request.resource.data.id == rollId
        && request.resource.data.materialName is string && request.resource.data.materialName.size() <= 100
        && isValidDate(request.resource.data.date)
        && (!('openedAt' in request.resource.data) || request.resource.data.openedAt is string)
        && (!('barcode' in request.resource.data) || (request.resource.data.barcode is string && request.resource.data.barcode.size() <= 200))
        && request.resource.data.operator is string && request.resource.data.operator.size() <= 100
        && request.resource.data.createdBy is string
        && request.resource.data.status is string && (request.resource.data.status == 'Unopened' || request.resource.data.status == 'Active' || request.resource.data.status == 'Consumed')
        && (!('metersTotal' in request.resource.data) || ((request.resource.data.metersTotal is int || request.resource.data.metersTotal is float) && request.resource.data.metersTotal >= 0))
        && (!('consumedMeters' in request.resource.data) || ((request.resource.data.consumedMeters is int || request.resource.data.consumedMeters is float) && request.resource.data.consumedMeters >= 0))
        && (!('initialWeightKg' in request.resource.data) || (request.resource.data.initialWeightKg is int || request.resource.data.initialWeightKg is float))
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000))
        && (!('closedAt' in request.resource.data) || request.resource.data.closedAt is string)
        && (!('closedBy' in request.resource.data) || request.resource.data.closedBy is string);
      allow delete: if isValidId(rollId);
    }

    // Settings / Daily Targets Document - Protected against accidental wipeout
    match /settings/{document} {
      allow read: if true;
      allow create, update: if isValidId(document);
      // Strictly block deletion of critical settings documents
      allow delete: if false;
    }

    // Security Backups Collection - Immutable backups vault
    match /backups/{backupId} {
      allow read: if true;
      allow create, update: if isValidId(backupId) && request.resource.data.id == backupId;
      allow delete: if isValidId(backupId);
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if isValidId(notificationId);
      allow delete: if isValidId(notificationId);
    }
  }
}
