rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security validators
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Profiles Collection
    match /profiles/{profileId} {
      allow read: if true;
      allow create, update: if isValidId(profileId) 
        && request.resource.data.id == profileId
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.role is string && (request.resource.data.role == 'manager' || request.resource.data.role == 'worker')
        && request.resource.data.username is string && request.resource.data.username.size() <= 100
        && request.resource.data.password is string && request.resource.data.password.size() <= 100;
      allow delete: if isValidId(profileId);
    }

    // Stock Entries Collection
    match /stock_entries/{entryId} {
      allow read: if true;
      allow create, update: if isValidId(entryId)
        && request.resource.data.id == entryId
        && request.resource.data.modelId is string && request.resource.data.modelId.size() <= 50
        && request.resource.data.workerName is string && request.resource.data.workerName.size() <= 100
        && request.resource.data.date is string && request.resource.data.date.size() <= 50
        && (request.resource.data.quantity is int || request.resource.data.quantity is float)
        && request.resource.data.createdBy is string
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);
      allow delete: if isValidId(entryId);
    }

    // Deliveries Collection
    match /deliveries/{deliveryId} {
      allow read: if true;
      allow create, update: if isValidId(deliveryId)
        && request.resource.data.id == deliveryId
        && request.resource.data.modelId is string && request.resource.data.modelId.size() <= 50
        && request.resource.data.model is string && request.resource.data.model.size() <= 50
        && request.resource.data.workerName is string && request.resource.data.workerName.size() <= 100
        && request.resource.data.loadedBy is string && request.resource.data.loadedBy.size() <= 100
        && request.resource.data.invoiceNumber is string && request.resource.data.invoiceNumber.size() <= 100
        && isValidDate(request.resource.data.date)
        && request.resource.data.deliveryDate is string && request.resource.data.deliveryDate.size() <= 50
        && request.resource.data.deliveryTime is string && request.resource.data.deliveryTime.size() <= 50
        && (request.resource.data.quantity is int || request.resource.data.quantity is float) && request.resource.data.quantity >= 0
        && request.resource.data.createdBy is string
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);
      allow delete: if isValidId(deliveryId);
    }

    // Production Plans Collection
    match /production_plans/{planId} {
      allow read: if true;
      allow create, update: if isValidId(planId)
        && request.resource.data.id == planId
        && request.resource.data.planDate is string && request.resource.data.planDate.size() <= 50
        && request.resource.data.machine is string && request.resource.data.machine.size() <= 50
        && request.resource.data.shift is string && request.resource.data.shift.size() <= 50
        && request.resource.data.model is string && request.resource.data.model.size() <= 50
        && (request.resource.data.quantityPlanned is int || request.resource.data.quantityPlanned is float) && request.resource.data.quantityPlanned >= 0
        && request.resource.data.assignedWorker is string && request.resource.data.assignedWorker.size() <= 100
        && request.resource.data.status is string && (request.resource.data.status == 'Pending' || request.resource.data.status == 'Completed' || request.resource.data.status == 'Delayed')
        && request.resource.data.createdBy is string
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);
      allow delete: if isValidId(planId);
    }

    // Rolls Traceability Collection (Permanent factory traceability - Active & Closed rolls are NEVER deletable)
    match /rolls/{rollId} {
      allow read: if true;
      allow create, update: if isValidId(rollId)
        && request.resource.data.id == rollId
        && request.resource.data.materialName is string && request.resource.data.materialName.size() <= 100
        && (!('date' in request.resource.data) || isValidDate(request.resource.data.date) || request.resource.data.date is string)
        && (!('openedAt' in request.resource.data) || request.resource.data.openedAt is string)
        && (!('barcode' in request.resource.data) || (request.resource.data.barcode is string && request.resource.data.barcode.size() <= 200))
        && (!('operator' in request.resource.data) || (request.resource.data.operator is string && request.resource.data.operator.size() <= 100))
        && (!('createdBy' in request.resource.data) || request.resource.data.createdBy is string)
        && (!('status' in request.resource.data) || request.resource.data.status is string);
      // Allow deletion of rolls (unopened, or active rolls opened/created by mistake)
      allow delete: if isValidId(rollId);
    }

    // Settings / Daily Targets Document - Protected against accidental wipeout
    match /settings/{document} {
      allow read: if true;
      allow create, update: if isValidId(document);
      // Strictly block deletion of critical settings documents
      allow delete: if false;
    }

    // Security Backups & Snapshots Collection - Immutable backups vault
    match /backups/{backupId} {
      allow read: if true;
      allow create, update: if isValidId(backupId) && request.resource.data.id == backupId;
      // Immutable: Backups can NEVER be deleted
      allow delete: if false;
    }

    match /security_snapshots/{snapshotId} {
      allow read: if true;
      allow create, update: if isValidId(snapshotId);
      // Immutable master vault
      allow delete: if false;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if isValidId(notificationId);
      allow delete: if isValidId(notificationId);
    }

    // Finished Piece Prices Collection - Confidential Manager Data
    match /piece_prices/{priceId} {
      allow read: if true;
      allow create, update: if isValidId(priceId)
        && request.resource.data.id == priceId
        && request.resource.data.reference is string && request.resource.data.reference.size() <= 100
        && request.resource.data.material is string && request.resource.data.material.size() <= 100
        && (request.resource.data.pricePerPiece is int || request.resource.data.pricePerPiece is float) && request.resource.data.pricePerPiece >= 0;
      allow delete: if false; // Protect price history from accidental deletion
    }

    // Financial Evaluations Collection - Confidential Manager Data (Permanent Audit Trail)
    match /financial_evaluations/{evalId} {
      allow read: if true;
      allow create, update: if isValidId(evalId)
        && request.resource.data.id == evalId
        && request.resource.data.rollId is string && request.resource.data.rollId.size() <= 128
        && request.resource.data.materialName is string && request.resource.data.materialName.size() <= 100
        && (request.resource.data.rollLength is int || request.resource.data.rollLength is float) && request.resource.data.rollLength >= 0
        && (request.resource.data.rollCost is int || request.resource.data.rollCost is float) && request.resource.data.rollCost >= 0
        && (request.resource.data.totalPieces is int || request.resource.data.totalPieces is float) && request.resource.data.totalPieces >= 0
        && (request.resource.data.totalProductionValue is int || request.resource.data.totalProductionValue is float)
        && (request.resource.data.grossProfit is int || request.resource.data.grossProfit is float)
        && (request.resource.data.profitPercentage is int || request.resource.data.profitPercentage is float);
      // Permanent Audit Record: evaluations can NEVER be deleted
      allow delete: if false;
    }

    // Expected Yields Configuration Collection
    match /expected_yields/{yieldId} {
      allow read: if true;
      allow create, update: if isValidId(yieldId)
        && request.resource.data.id == yieldId
        && (request.resource.data.expectedPieces is int || request.resource.data.expectedPieces is float) && request.resource.data.expectedPieces >= 0;
      allow delete: if false;
    }

    // Independent Madrid Stock Collection (One document per AirbagModel reference)
    match /madrid_stock/{modelId} {
      allow read: if true;
      allow create, update: if modelId is string && modelId.size() <= 100
        && request.resource.data.reference == modelId
        && (request.resource.data.packagedQuantity is int || request.resource.data.packagedQuantity is float)
        && request.resource.data.packagedQuantity >= 0
        && request.resource.data.lastUpdated is string
        && request.resource.data.updatedBy is string;
      allow delete: if false;
    }

    // Madrid Import History Snapshots Collection (Immutable audit trail of Madrid Excel snapshots)
    match /madrid_import_history/{importId} {
      allow read: if true;
      allow create, update: if isValidId(importId)
        && request.resource.data.id == importId
        && request.resource.data.importedAt is string
        && request.resource.data.importedBy is string
        && (request.resource.data.totalPackagedQuantity is int || request.resource.data.totalPackagedQuantity is float)
        && request.resource.data.totalPackagedQuantity >= 0;
      allow delete: if false;
    }

    // Phase 1: Reference Catalog Collection (Active 8 references + preserved INACTIVE references like REPUESTO X87 and VW110)
    match /catalog_references/{refId} {
      allow read: if true;
      allow create, update: if refId is string && refId.size() <= 100
        && request.resource.data.id == refId
        && request.resource.data.code is string && request.resource.data.code.size() <= 100
        && request.resource.data.isActive is bool
        && (request.resource.data.workflowType == 'SPAIN_TRANSFER' || request.resource.data.workflowType == 'MOROCCO_DOMESTIC')
        && (request.resource.data.leadTimeWeeks is int || request.resource.data.leadTimeWeeks is float)
        && request.resource.data.leadTimeWeeks >= 0
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy is string;
      allow delete: if false; // Never delete catalog references; mark isActive = false instead
    }

    // Weekly Customer Demands & Manual Production Plans Collection (W41..W52+ manual weekly planning)
    match /weekly_customer_demands/{demandId} {
      allow read: if true;
      allow create, update: if demandId is string && demandId.size() <= 128
        && request.resource.data.id == demandId
        && (request.resource.data.year is int || request.resource.data.year is float)
        && (request.resource.data.weekNumber is int || request.resource.data.weekNumber is float)
        && request.resource.data.modelId is string && request.resource.data.modelId.size() <= 50
        && (request.resource.data.workflowType == 'SPAIN_TRANSFER' || request.resource.data.workflowType == 'MOROCCO_DOMESTIC')
        && (request.resource.data.customerRequiredQty is int || request.resource.data.customerRequiredQty is float) && request.resource.data.customerRequiredQty >= 0
        && (!('plannedProductionQty' in request.resource.data) || ((request.resource.data.plannedProductionQty is int || request.resource.data.plannedProductionQty is float) && request.resource.data.plannedProductionQty >= 0))
        && (!('plannedTangerToMadridQty' in request.resource.data) || ((request.resource.data.plannedTangerToMadridQty is int || request.resource.data.plannedTangerToMadridQty is float) && request.resource.data.plannedTangerToMadridQty >= 0))
        && (request.resource.data.deliveredQty is int || request.resource.data.deliveredQty is float) && request.resource.data.deliveredQty >= 0
        && (request.resource.data.pendingQty is int || request.resource.data.pendingQty is float) && request.resource.data.pendingQty >= 0
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy is string;
      allow delete: if demandId is string && demandId.size() <= 128;
    }

    // Phase 1: Spain Truck Shipments Collection (Planned -> Dispatched -> In Transit -> Received in Madrid)
    match /spain_truck_shipments/{shipmentId} {
      allow read: if true;
      allow create, update: if isValidId(shipmentId)
        && request.resource.data.id == shipmentId
        && request.resource.data.truckCode is string && request.resource.data.truckCode.size() <= 100
        && (request.resource.data.status == 'planned'
          || request.resource.data.status == 'dispatched'
          || request.resource.data.status == 'in_transit'
          || request.resource.data.status == 'received_in_madrid'
          || request.resource.data.status == 'cancelled')
        && (request.resource.data.totalPlannedQty is int || request.resource.data.totalPlannedQty is float) && request.resource.data.totalPlannedQty >= 0
        && (request.resource.data.totalDispatchedQty is int || request.resource.data.totalDispatchedQty is float) && request.resource.data.totalDispatchedQty >= 0
        && (request.resource.data.totalReceivedQty is int || request.resource.data.totalReceivedQty is float) && request.resource.data.totalReceivedQty >= 0
        && request.resource.data.createdBy is string
        && request.resource.data.createdAt is string;
      allow delete: if false; // Never silently delete truck shipment records
    }

    // Madrid Stock Movements Audit Ledger (Baseline imports, physical corrections, receipts from Tanger & customer deliveries)
    match /madrid_stock_movements/{movementId} {
      allow read: if true;
      allow create, update: if isValidId(movementId)
        && request.resource.data.id == movementId
        && request.resource.data.idempotencyKey is string && request.resource.data.idempotencyKey.size() <= 200
        && request.resource.data.modelId is string && request.resource.data.modelId.size() <= 50
        && request.resource.data.modelId != 'TETOUAN'
        && (request.resource.data.movementType == 'BASELINE_SNAPSHOT_IMPORT'
          || request.resource.data.movementType == 'PHYSICAL_STOCK_CORRECTION'
          || request.resource.data.movementType == 'TRUCK_RECEIPT_IN_MADRID'
          || request.resource.data.movementType == 'CUSTOMER_DELIVERY_FROM_MADRID')
        && (request.resource.data.quantityDelta is int || request.resource.data.quantityDelta is float)
        && (request.resource.data.physicalStockBefore is int || request.resource.data.physicalStockBefore is float)
        && (request.resource.data.physicalStockAfter is int || request.resource.data.physicalStockAfter is float)
        && request.resource.data.baselineSnapshotId is string
        && request.resource.data.isAppliedToCurrentBaseline is bool
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy is string;
      allow delete: if false; // Immutable audit trail
    }

    // Phase 1: Confirmed Customer Deliveries Ledger (Spain & Domestic W41..W52 fulfillment records)
    match /customer_deliveries/{deliveryId} {
      allow read: if true;
      allow create, update: if isValidId(deliveryId)
        && request.resource.data.id == deliveryId
        && request.resource.data.idempotencyKey is string && request.resource.data.idempotencyKey.size() <= 200
        && request.resource.data.demandId is string && request.resource.data.demandId.size() <= 128
        && request.resource.data.modelId is string && request.resource.data.modelId.size() <= 50
        && (request.resource.data.deliveredQuantity is int || request.resource.data.deliveredQuantity is float) && request.resource.data.deliveredQuantity > 0
        && request.resource.data.deliveryDate is string
        && request.resource.data.invoiceOrRef is string && request.resource.data.invoiceOrRef.size() <= 100
        && request.resource.data.deductedFromMadridStock is bool
        && request.resource.data.confirmedBy is string
        && request.resource.data.confirmedAt is string;
      allow delete: if false; // Permanent customer delivery confirmation log
    }
  }
}
