{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role, station, username, and password",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["manager", "worker"] },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "station": { "type": "string" },
        "fcmToken": { "type": "string" },
        "notificationEnabled": { "type": "boolean" },
        "lastTokenUpdate": { "type": "string" }
      },
      "required": ["id", "name", "role", "username", "password"]
    },
    "StockEntry": {
      "title": "StockEntry",
      "description": "Record of stock manufactured by a worker on a specific date",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "modelId": { "type": "string" },
        "workerName": { "type": "string" },
        "date": { "type": "string" },
        "quantity": { "type": "integer" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "machine": { "type": "string" },
        "planId": { "type": "string" },
        "type": { "type": "string", "enum": ["production", "packaging"] },
        "originalQuantity": { "type": "integer" },
        "correctedQuantity": { "type": "integer" },
        "difference": { "type": "integer" },
        "edited": { "type": "boolean" },
        "editedBy": { "type": "string" },
        "editedByProfileId": { "type": "string" },
        "editedAt": { "type": "string" },
        "editReason": { "type": "string" }
      },
      "required": ["id", "modelId", "workerName", "date", "quantity", "createdBy", "createdAt"]
    },
    "ProductionPlan": {
      "title": "ProductionPlan",
      "description": "Planned production target for a specific machine, shift, and model",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "planDate": { "type": "string" },
        "machine": { "type": "string" },
        "shift": { "type": "string" },
        "model": { "type": "string" },
        "quantityPlanned": { "type": "integer" },
        "assignedWorker": { "type": "string" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Completed", "Delayed"] }
      },
      "required": ["id", "planDate", "machine", "shift", "model", "quantityPlanned", "assignedWorker", "status", "createdBy", "createdAt"]
    },
    "DailyTargets": {
      "title": "DailyTargets",
      "description": "Dynamic mapping of date strings to target quantity values",
      "type": "object",
      "properties": {
        "targets": { "type": "object" }
      },
      "required": ["targets"]
    },
    "DeliveryEntry": {
      "title": "DeliveryEntry",
      "description": "Record of stock delivered and removed from stockpile with detailed traceability",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "modelId": { "type": "string" },
        "model": { "type": "string" },
        "workerName": { "type": "string" },
        "loadedBy": { "type": "string" },
        "date": { "type": "string" },
        "deliveryDate": { "type": "string" },
        "deliveryTime": { "type": "string" },
        "quantity": { "type": "integer" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "invoiceNumber": { "type": "string" }
      },
      "required": ["id", "modelId", "model", "workerName", "loadedBy", "date", "deliveryDate", "deliveryTime", "quantity", "createdBy", "createdAt", "invoiceNumber"]
    },
    "DatabaseNotification": {
      "title": "DatabaseNotification",
      "description": "System alerts or push notifications logged inside Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "createdAt": { "type": "string" },
        "category": { "type": "string", "enum": ["delivery", "stock", "target", "plan", "system"] },
        "readBy": { "type": "array" },
        "targetRole": { "type": "string", "enum": ["manager", "worker", "all"] },
        "targetUserId": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "body", "createdAt", "category", "readBy", "targetRole"]
    },
    "RollEntry": {
      "title": "RollEntry",
      "description": "Traceability record of physical laser material rolls in stock and production",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rollNumber": { "type": "string" },
        "materialId": { "type": "string" },
        "materialCode": { "type": "string" },
        "materialName": { "type": "string" },
        "supplierName": { "type": "string" },
        "batchNumber": { "type": "string" },
        "lotNumber": { "type": "string" },
        "receptionDate": { "type": "string" },
        "originalLength": { "type": "number" },
        "remainingLength": { "type": "number" },
        "width": { "type": "number" },
        "pricingType": { "type": "string", "enum": ["PER_LINEAR_METER", "PER_SQUARE_METER"] },
        "originalUnitPrice": { "type": "number" },
        "originalArea": { "type": "number" },
        "originalValue": { "type": "number" },
        "remainingArea": { "type": "number" },
        "remainingValue": { "type": "number" },
        "locationName": { "type": "string" },
        "status": { "type": "string", "enum": ["IN_STOCK", "IN_USE", "PARTIALLY_USED", "EMPTY", "WASTE", "TRANSFERRED", "BLOCKED", "Unopened", "Active", "Consumed"] },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" },
        "notes": { "type": "string" },
        "barcode": { "type": "string" },
        "date": { "type": "string" },
        "operator": { "type": "string" }
      },
      "required": ["id", "rollNumber", "materialName", "originalLength", "remainingLength", "status"]
    },
    "RollMovement": {
      "title": "RollMovement",
      "description": "Historical audit record of every receipt, laser consumption, waste, and transfer event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rollId": { "type": "string" },
        "rollNumber": { "type": "string" },
        "materialId": { "type": "string" },
        "materialCode": { "type": "string" },
        "materialName": { "type": "string" },
        "type": { "type": "string", "enum": ["RECEIPT", "CONSUMPTION", "WASTE", "ADJUSTMENT", "RETURN", "TRANSFER"] },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "enum": ["METER", "SQUARE_METER"] },
        "dateTime": { "type": "string" },
        "operatorName": { "type": "string" },
        "machineName": { "type": "string" },
        "jobReference": { "type": "string" },
        "fromLocationName": { "type": "string" },
        "toLocationName": { "type": "string" },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "unitPrice": { "type": "number" },
        "calculatedCost": { "type": "number" },
        "remainingLengthAfter": { "type": "number" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "rollId", "rollNumber", "type", "quantity", "dateTime", "operatorName", "calculatedCost", "remainingLengthAfter"]
    },
    "MaterialMaster": {
      "title": "MaterialMaster",
      "description": "Master catalog of industrial airbag fabric specifications and pricing contracts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "typeColor": { "type": "string" },
        "supplierName": { "type": "string" },
        "standardWidthM": { "type": "number" },
        "referenceLengthM": { "type": "number" },
        "pricingType": { "type": "string", "enum": ["PER_LINEAR_METER", "PER_SQUARE_METER"] },
        "unitPrice": { "type": "number" },
        "active": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "required": ["id", "code", "name", "pricingType", "unitPrice", "active"]
    },
    "LocationItem": {
      "title": "LocationItem",
      "description": "Industrial factory zones, warehouses, and laser cutting machines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["WAREHOUSE", "MACHINE", "QUARANTINE", "SCRAP"] },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "code", "type", "active"]
    }
  },
  "firestore": {
    "profiles/{profileId}": {
      "schema": "UserProfile",
      "description": "User profile definitions inside the system"
    },
    "stock_entries/{entryId}": {
      "schema": "StockEntry",
      "description": "Submitted stock entries for each airbag model"
    },
    "production_plans/{planId}": {
      "schema": "ProductionPlan",
      "description": "Production plans or schedules for shifts"
    },
    "deliveries/{deliveryId}": {
      "schema": "DeliveryEntry",
      "description": "Shipped deliveries from stockpile"
    },
    "rolls/{rollId}": {
      "schema": "RollEntry",
      "description": "Traceability collection for physical material rolls"
    },
    "roll_movements/{movementId}": {
      "schema": "RollMovement",
      "description": "Historical audit log of all roll transactions"
    },
    "materials/{materialId}": {
      "schema": "MaterialMaster",
      "description": "Master fabric definition catalog"
    },
    "locations/{locationId}": {
      "schema": "LocationItem",
      "description": "Master list of factory locations and machines"
    },
    "notifications/{notificationId}": {
      "schema": "DatabaseNotification",
      "description": "Log of alerts, target thresholds and dispatch signals"
    },
    "settings/daily_targets": {
      "schema": "DailyTargets",
      "description": "Custom daily targets mapping"
    }
  }
}
